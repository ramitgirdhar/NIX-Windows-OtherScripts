#!/usr/bin/env bash
#
# find_unused_models.sh
#
# Scans ComfyUI workflow JSON files for referenced model filenames, then
# compares that list against all model files on disk to find files that
# aren't referenced by any workflow (candidates for cleanup).
#
# Usage:
#   ./find_unused_models.sh [WORKFLOWS_DIR] [MODELS_DIR]
#
# Defaults:
#   WORKFLOWS_DIR = /workspace/runpod-slim/ComfyUI/user/default/workflows
#   MODELS_DIR    = /workspace/runpod-slim/ComfyUI/models
#
# Output:
#   Prints the list of model filenames referenced in workflows,
#   the full list of model files on disk (sorted by size, largest first),
#   and finally the unused files (sorted by size, largest first,
#   human-readable sizes).

set -euo pipefail

WORKFLOWS_DIR="${1:-/workspace/runpod-slim/ComfyUI/user/default/workflows}"
MODELS_DIR="${2:-/workspace/runpod-slim/ComfyUI/models}"

USED_LIST="$(mktemp)"
DISK_LIST="$(mktemp)"
trap 'rm -f "$USED_LIST" "$DISK_LIST"' EXIT

if [[ ! -d "$WORKFLOWS_DIR" ]]; then
    echo "Error: workflows dir not found: $WORKFLOWS_DIR" >&2
    exit 1
fi
if [[ ! -d "$MODELS_DIR" ]]; then
    echo "Error: models dir not found: $MODELS_DIR" >&2
    exit 1
fi

echo "=== Models referenced in workflows ($WORKFLOWS_DIR) ==="
grep -ohrE '"[^"]+\.(safetensors|ckpt|pt|pth|bin|gguf|onnx)"' "$WORKFLOWS_DIR" \
    | tr -d '"' \
    | sed 's/.*\///' \
    | sort -u > "$USED_LIST"
cat "$USED_LIST"

echo
echo "=== Model files on disk ($MODELS_DIR), sorted by size ==="
find "$MODELS_DIR" -type f \
    \( -name "*.safetensors" -o -name "*.ckpt" -o -name "*.pt" -o -name "*.pth" \
       -o -name "*.bin" -o -name "*.gguf" -o -name "*.onnx" \) \
    -printf '%s\t%p\n' | sort -rn > "$DISK_LIST"
cat "$DISK_LIST"

echo
echo "=== Unused model files (not referenced by any workflow), largest first ==="
awk -F'\t' '{n=$2; sub(/.*\//,"",n); print n"\t"$0}' "$DISK_LIST" \
    | while IFS=$'\t' read -r base size path; do
        grep -qxF "$base" "$USED_LIST" || printf '%s\t%s\n' "$size" "$path"
      done | sort -rn | numfmt --to=iec --field=1
